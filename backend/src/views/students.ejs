<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student registration</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f3f5f9;
            color: #182337;
            font: 16px/1.5 system-ui, sans-serif;
        }

        main {
            max-width: 960px;
            margin: 40px auto;
            padding: 0 20px;
        }

        h1,
        h2 {
            line-height: 1.2;
        }

        .intro {
            color: #526078;
        }

        .layout {
            display: grid;
            grid-template-columns: 1fr 1.3fr;
            gap: 24px;
            align-items: start;
        }

        section {
            background: white;
            border: 1px solid #dde3ec;
            border-radius: 14px;
            padding: 24px;
        }

        h2 {
            margin-top: 0;
            font-size: 22px;
        }

        label {
            display: block;
            margin-top: 16px;
            font-weight: 600;
        }

        input,
        button {
            width: 100%;
            padding: 12px;
            font: inherit;
            border-radius: 7px;
        }

        input {
            margin-top: 6px;
            border: 1px solid #aab5c5;
        }

        button {
            margin-top: 22px;
            background: #2458cf;
            color: white;
            border: 0;
            cursor: pointer;
        }

        .delete-button {
            width: auto;
            min-width: 80px;
            margin-top: 0;
            padding: 8px 12px;
            background: #b42318;
        }

        button:disabled {
            opacity: .6;
            cursor: wait;
        }

        :focus-visible {
            outline: 3px solid #83aaff;
            outline-offset: 3px;
        }

        #message,
        .error {
            color: #b42318;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th,
        td {
            padding: 12px 8px;
            border-bottom: 1px solid #e4e9f0;
            overflow-wrap: anywhere;
        }

        @media (max-width: 700px) {
            .layout {
                grid-template-columns: 1fr;
            }

            main {
                margin-top: 24px;
            }
        }
    </style>
</head>

<body>
    <main>
        <h1>Students</h1>
        <p class="intro">Register a student and view saved registrations.</p>
        <div class="layout">
            <section aria-labelledby="register-title">
                <h2 id="register-title">Add student</h2>
                <form id="registration-form" action="/api/v1/students/register" method="post">
                    <label for="name">Name</label>
                    <input id="name" name="name" autocomplete="name" required>
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" autocomplete="email" required>
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password" autocomplete="new-password" required>
                    <button type="submit">Register student</button>
                    <p id="message" role="status" aria-live="polite"></p>
                </form>
            </section>
            <section aria-labelledby="list-title">
                <h2 id="list-title">Saved students<% if (!error) { %> (<%= students.length %>)<% } %>
                </h2>
                <% if (error) { %>
                    <p class="error" role="alert">
                        <%= error %>
                    </p>
                    <a href="/api/v1/students/register">Retry</a>
                    <% } else if (students.length===0) { %>
                        <p>No students yet. Add your first student using the form.</p>
                        <% } else { %>
                            <div class="table-wrap">
                                <table>
                                    <thead>
                                        <tr>
                                            <th scope="col">Name</th>
                                            <th scope="col">Email</th>
                                            <th scope="col">Password</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% students.forEach(student=> { %>
                                            <tr data-student-row="<%= student._id %>">
                                                <td>
                                                    <%= student.name %>
                                                </td>
                                                <td>
                                                    <%= student.email || '—' %>
                                                </td>
                                                <td>
                                                    <%= student.password || '—' %>
                                                </td>
                                                <td>
                                                    <button class="delete-button" type="button"
                                                        data-delete-student="<%= student._id %>"
                                                        data-student-name="<%= student.name %>">
                                                        Delete
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } %>
            </section>
        </div>
    </main>
    <script>
        const form = document.getElementById('registration-form');
        const button = form.querySelector('button');
        const message = document.getElementById('message');

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            button.disabled = true;
            message.textContent = 'Saving student…';
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(Object.fromEntries(new FormData(form)))
                });
                const data = await response.json();
                if (!response.ok) {
                    message.textContent = data.message || 'Registration failed. Please try again.';
                    return;
                }
                window.location.assign('/api/v1/students/register');
            } catch (error) {
                message.textContent = 'Unable to reach the server. Please try again.';
            } finally {
                button.disabled = false;
            }
        });

        document.querySelectorAll('[data-delete-student]').forEach((deleteButton) => {
            deleteButton.addEventListener('click', async () => {
                const studentId = deleteButton.dataset.deleteStudent;
                const studentName = deleteButton.dataset.studentName || 'this student';
                const confirmed = window.confirm(`Delete ${studentName}?`);

                if (!confirmed) {
                    return;
                }

                deleteButton.disabled = true;
                deleteButton.textContent = 'Deleting...';

                try {
                    const response = await fetch(`/api/v1/students/${studentId}`, {
                        method: 'DELETE',
                    });
                    const data = await response.json();

                    if (!response.ok) {
                        window.alert(data.message || 'Delete failed. Please try again.');
                        deleteButton.disabled = false;
                        deleteButton.textContent = 'Delete';
                        return;
                    }

                    window.location.assign('/api/v1/students/register');
                } catch (error) {
                    window.alert('Unable to reach the server. Please try again.');
                    deleteButton.disabled = false;
                    deleteButton.textContent = 'Delete';
                }
            });
        });
    </script>
</body>

</html>
