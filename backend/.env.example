PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/college-placement
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=your-sender@gmail.com
# Set both values to create the initial TPO account on backend startup.
# Existing accounts are never overwritten by this bootstrap.
TPO_EMAIL=admin@gmail.com
TPO_PASSWORD=admin123
